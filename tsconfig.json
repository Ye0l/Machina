{
  "compilerOptions": {
    "strict": true,
    "incremental": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "/srv/*": ["./srv/*"],
      "/common/*": ["./common/*"],
      "/hub/*": ["./hub/*"]
    }
  },
  "include": ["srv", "common", "tests"]
}
