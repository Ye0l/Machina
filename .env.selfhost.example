# Copy to `.env` before running `pnpm run docker:up`.
#
# This is for the containerised stack (docker-compose.selfhost.yml). `.env.template` is the
# separate, development-from-source set.

# Required. Generate with: openssl rand -hex 32
# Changing it later invalidates every existing session.
JWT_SECRET=

# Required. Applied on every boot -- if the account already exists, its password is RESET to
# this value, so treat this file as a secret and change the password in the app afterwards.
INITIAL_USER=admin
INITIAL_PASSWORD=

# Host port the app is published on. The container always listens on 3001.
PORT=3001

DB_NAME=agnai
LOG_LEVEL=info

# Published image tag to run. `dev` tracks the default branch. `pnpm run docker:build` ignores
# this and builds from the checkout instead.
TAG=dev

# Megabytes. Bounds an uploaded image and the JSON body it travels in -- a character asset is
# sent as base64, which is a third larger than the file itself. Raise if an import is refused.
JSON_SIZE_LIMIT=64
IMAGE_SIZE_LIMIT=64
